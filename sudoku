      if (!todo.length) { log('already complete ✔  (' + st.mode + ' / ' + st.difficulty + ')'); state.busy = false; return; }

      var p = progress(st);
      log('mode: %c' + st.mode + ' / ' + st.difficulty + (st.id ? '  (level ' + st.id + ')' : ''),
          'color:#fff;font-weight:700');
      log('to fill: ' + todo.length + ' cells   input: ' + inputMethods().join(' → ') +
          (st.cages ? '   killer cages: ' + st.cages.length : ''));
      if (opts.dryRun) {
        console.log(fmtGrid(st.values, '.'));
        log('dry run — nothing was changed');
        state.busy = false; return;
      }

      var t0 = Date.now(), failed = [], last = 0;
      for (i = 0; i < todo.length; i++) {
        var ok = await fillOne(todo[i], st.solution[todo[i]]);
        if (!ok) failed.push(todo[i]);
        if (cfg.delay >= 15 && Date.now() - last > 900) {
          last = Date.now();
          console.log('   ' + Math.round((i + 1) / todo.length * 100) + '%  (' + (i + 1) + '/' + todo.length + ')');
        }
      }
      await sleep(150);
      var after = snapshot(), left = 0, wrong = 0;
      if (after) for (i = 0; i < 81; i++) {
        if (after.editable[i] && after.values[i] !== after.solution[i]) {
          if (after.values[i] === 0) left++; else wrong++;
        }
      }
      var secs = ((Date.now() - t0) / 1000).toFixed(1);
      if (!left && !wrong) {
        log('%cPUZZLE SOLVED ✔%c  ' + todo.length + ' cells in ' + secs + 's',
            'color:#00e676;font-weight:700', '');
      } else {
        warn(left + ' empty / ' + wrong + ' wrong after ' + secs + 's');
        if (failed.length) warn('stubborn cells: ' + failed.map(function (k) {
          return 'r' + (((k / 9) | 0) + 1) + 'c' + (k % 9 + 1);
        }).join(', '));
        warn('try: SUDOKU.test()   →   or SUDOKU.solve({delay:80, method:"tap"})');
      }
      state.busy = false;
    } catch (e) {
      state.busy = false;
      bad('error:', e && e.message ? e.message : e);
      throw e;
    } finally {
      cfg.delay = oldDelay; cfg.verify = oldVerify; cfg.method = oldMethod;
    }
  }

  async function step() {
    var st = await forceSave(true);
    if (!st || !st.solution) { bad('no board data — run SUDOKU.test()'); return; }
    for (var i = 0; i < 81; i++) {
      if (st.editable[i] && st.values[i] !== st.solution[i]) {
        var ok = await fillOne(i, st.solution[i]);
        log('r' + (((i / 9) | 0) + 1) + 'c' + (i % 9 + 1) + ' = ' + st.solution[i] + (ok ? ' ✔' : ' ✖'));
        return;
      }
    }
    log('nothing left to fill ✔');
  }

  function auto(on) {
    if (on === false) {
      if (state.autoTimer) clearInterval(state.autoTimer);
      state.autoTimer = null;
      log('auto mode off');
      return;
    }
    if (state.autoTimer) { log('auto mode already running'); return; }
    log('auto mode ON — the board is solved now and again after every restart');
    warn('(a brand-new puzzle loads a fresh page, which clears this script — paste it again, ' +
         'or use the userscript/bookmarklet version)');
    state.autoTimer = setInterval(async function () {
      if (state.busy) return;
      var st = snapshot();
      if (!st || !st.solution) {

        if (state.lastRead && Date.now() - state.lastRead < 4000) return;
        state.lastRead = Date.now();
        st = await forceSave(true);
        if (!st || !st.solution) return;
      }
      if (st.finished) return;
      if (!progress(st).need) return;
      var tag = st.mode + '/' + st.difficulty + '/' + st.id;
      var now = Date.now();

      if (state.lastTry[tag] && now - state.lastTry[tag] < 20000) return;
      state.lastTry[tag] = now;
      await solve({ quiet: true });
    }, 1200);
  }

  async function probeInput() {
    var wasNotes = notesOn(), st, idx = null, i, j;
    if (!wasNotes) { tap(pencilButton()); await sleep(110); }
    if (!notesOn()) { if (!wasNotes) {} return { note: 'pencil (notes) mode unavailable — probe skipped to protect your lives' }; }

    st = snapshot();
    if (st) for (i = 0; i < 81; i++) if (st.editable[i] && !st.values[i]) { idx = i; break; }
    if (idx === null) { st = await forceSave(true); if (st) for (i = 0; i < 81; i++) if (st.editable[i] && !st.values[i]) { idx = i; break; } }
    if (idx === null) { if (!wasNotes) tap(pencilButton()); return { note: 'no empty cell to test with' }; }

    var out = {}, firstWorked = null;
    var order = (pref === 'tap' || (isTouchDevice && pref !== 'key')) ? ['tap', 'key'] : ['key', 'tap'];
    for (var m = 0; m < 2; m++) {
      var how = order[m];
      if (how === 'tap' && !numpadItem(1)) { out.tap = 'no numpad'; continue; }
      selectCell(idx); await sleep(Math.max(40, cfg.delay));
      await typeValue(5, how); await sleep(Math.max(60, cfg.delay));
      var after = snapshot(), note = null;
      if (after) note = after.notes[idx];
      var worked = !!(note && note[4] === 5);
      out[how] = worked;
      if (worked && !firstWorked) firstWorked = how;

      selectCell(idx); await sleep(Math.max(40, cfg.delay));
      await typeValue(5, how); await sleep(Math.max(60, cfg.delay));
      var back = snapshot();
      var stillThere = false;
      if (back) { var nn = back.notes[idx]; stillThere = !!(nn && nn[4] === 5); }
      if (stillThere) {
        selectCell(idx); await sleep(Math.max(40, cfg.delay));
        await typeValue(0, how); await sleep(Math.max(60, cfg.delay));
      }
    }
    if (firstWorked) pref = firstWorked;
    if (!wasNotes) { tap(pencilButton()); await sleep(80); }
    return out;
  }

  window.SUDOKU = {
    version: VERSION,
    cfg: cfg,
    get busy() { return state.busy; },

    async read(o) { return (o && o.cached) ? snapshot() : await forceSave(!!(o && o.quiet)); },
    async state() {
      var st = await forceSave(true);
      if (!st) { bad('no board data found'); return null; }
      var p = progress(st), sums = cageSums(st);
      log('mode      : ' + st.mode + ' / ' + st.difficulty + (st.id ? '  (level ' + st.id + ')' : ''));
      log('progress  : ' + (81 - p.need) + ' / 81   (' + p.have + ' editable placed, ' + p.need + ' to go)');
      log('timer     : ' + Math.floor(st.timer / 1000) + 's' + (st.finished ? '   — FINISHED' : ''));
      if (sums) log('killer    : ' + sums.length + ' cages → sums ' + sums.map(function (s) { return s.sum; }).join(', '));
      log('saved as  : ' + st.key);
      return st;
    },
    async board() {
      var st = await forceSave(true);
      if (!st) { bad('no board data found'); return; }
      console.log(fmtGrid(st.values, '.'));
      var p = progress(st);
      log((81 - p.need) + '/81 filled, ' + p.need + ' empty or wrong' + (st.finished ? '  — FINISHED' : ''));
      return st;
    },
    async solution() {
      var st = await forceSave(true);
      if (!st || !st.solution) { bad('no solution available'); return; }
      console.log(fmtGrid(st.solution, '?'));
      var problems = validate(st);
      log(problems.length ? 'consistency: ✖ ' + problems[0] : 'consistency checks: ✔ all good');
      return st.solution;
    },

    solve: solve,
    step: step,
    auto: auto,
    stop: function () { auto(false); state.busy = false; },

    async test() {
      log('SUDOKU v' + VERSION + ' diagnostic');
      var st = await forceSave(false);
      if (!st) { bad('no board data — is a puzzle open?'); return; }
      var problems = validate(st), sums = cageSums(st);
      log('device       : ' + (isTouchDevice ? 'touch (numpad taps preferred)' : 'desktop (keyboard preferred)') +
          '   Touch API: ' + (typeof window.Touch === 'function' ? 'yes' : 'no'));
      log('canvas       : ' + (canvasEl() ? 'found, ' + JSON.stringify(rectOf(canvasEl()).toJSON ? rectOf(canvasEl()).toJSON() : {}) : 'MISSING'));
      log('numpad       : ' + (numpadItem(1) ? 'found (#numpad .numpad-item)' : 'not found'));
      log('pencil/erase : ' + (pencilButton() ? 'found' : 'missing') + ' / ' + (eraseButton() ? 'found' : 'missing'));
      log('mode / diff  : ' + st.mode + ' / ' + st.difficulty + (st.id ? '  (level ' + st.id + ')' : ''));
      log('saved as     : ' + st.key);
      log('cages        : ' + (sums ? sums.length + ', total ' + sums.reduce(function (a, s) { return a + s.sum; }, 0) : '—'));
      log('blank cells  : ' + blankCellsByPixels().length + ' (by canvas pixels)');
      log('consistency  : ' + (problems.length ? '✖ ' + problems.join(' | ') : '✔'));
      var inp = await probeInput();
      log('input test   : tap → ' + (inp.tap === undefined ? inp.note : inp.tap ? 'WORKS ✔' : 'no') +
          '   key → ' + (inp.key === undefined ? inp.note : inp.key ? 'WORKS ✔' : 'no'));
      if (cfg.method === 'auto' && inp.tap === false && inp.key === true) cfg.method = 'key';
      else if (cfg.method === 'auto' && inp.tap === true && inp.key === false) cfg.method = 'tap';
      log('using method : ' + cfg.method + '  (' + inputMethods().join(' → ') + ')');
      return { state: st, problems: problems, input: inp };
    },
    async ping() { var st = await forceSave(false); log(st ? 'state read ✔' : 'failed'); return st; },
    async reset() { knownKey = null; log('cache cleared'); },

    help: function () {
      var rows = [
        ['SUDOKU.solve()', 'fill every empty cell (animated)'],
        ['SUDOKU.solve({delay:0})', 'instant'],
        ['SUDOKU.solve({delay:150})', 'slow and pretty'],
        ['SUDOKU.solve({dryRun:true})', 'show what would happen'],
        ['SUDOKU.solve({method:"tap"})', 'force on-screen numpad (mobile)'],
        ['SUDOKU.solve({method:"key"})', 'force keyboard input (desktop)'],
        ['SUDOKU.step()', 'fill one cell'],
        ['SUDOKU.auto()', 'auto-solve every new puzzle'],
        ['SUDOKU.auto(false)', 'stop auto mode'],
        ['SUDOKU.board()', 'print the current grid'],
        ['SUDOKU.solution()', 'print the solution'],
        ['SUDOKU.state()', 'mode / difficulty / progress'],
        ['SUDOKU.test()', 'diagnostics incl. input test'],
        ['SUDOKU.cfg.delay = 60', 'default speed (ms per action)']
      ];
      console.log('%c SUDOKU.COM SOLVER v' + VERSION + ' ', 'background:#111;color:#4de1ff;padding:3px 8px;border-radius:4px;font-weight:700');
      rows.forEach(function (r) { console.log('%c ' + r[0].padEnd(30), 'color:#4de1ff', r[1]); });
      log('classic · killer · daily · postcards · storybook — desktop & mobile');
    }
  };

  log('ready — v' + VERSION + '  •  type  %cSUDOKU.solve()%c  to solve, %cSUDOKU.test()%c to diagnose, %cSUDOKU.help()%c for everything',
      'color:#fff;font-weight:700', '', 'color:#fff;font-weight:700', '', 'color:#fff;font-weight:700', '');
})();
